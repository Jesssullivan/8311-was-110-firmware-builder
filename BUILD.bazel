package(default_visibility = ["//visibility:public"])

filegroup(
    name = "was110_builder_srcs",
    srcs = glob(
        [
            "audit/**",
            "containers/**",
            "docs/**",
            "files/**",
            "i18n/**",
            "mods/**",
            "packages/**",
            "pins/**",
            "tools/**",
            "whole_image/**",
            "8311-xgspon-bypass/**",
            ".gitmodules",
            "BUILD.bazel",
            "MODULE.bazel",
            "build.sh",
            "copy_packages.sh",
            "create.sh",
            "extract.sh",
            "flake.lock",
            "flake.nix",
            "system_sw.ini",
            "wholeImage.sh",
        ],
        allow_empty = True,
        exclude = [
            "out/**",
            "rootfs",
            "rootfs-bfw/**",
            "rootfs-basic/**",
            "whole_image/system_sw.img",
        ],
    ) + [
        "//bazel:srcs",
        "//bazel/platforms:srcs",
    ],
)

genrule(
    name = "public_vendor_handoff_fixture",
    srcs = [
        "@was110_vendor_blobs//:basic_bootcore",
        "@was110_vendor_blobs//:basic_kernel",
        "@was110_vendor_blobs//:basic_rootfs",
        "@was110_vendor_blobs//:bfw.img",
        "@was110_vendor_blobs//:pins_inputs",
    ],
    outs = ["public_vendor_handoff_fixture.SHA256SUMS"],
    cmd_bash = """
set -euo pipefail
sha256sum $(SRCS) > "$@"
""",
    tags = [
        "manual",
        "requires-was110-public-vendor-repo",
    ],
)

