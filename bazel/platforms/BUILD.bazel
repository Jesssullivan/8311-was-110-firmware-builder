package(default_visibility = ["//visibility:public"])

filegroup(
    name = "srcs",
    srcs = glob(["**"]),
)

platform(
    name = "was110_rbe_linux",
    constraint_values = [
        "@platforms//cpu:x86_64",
        "@platforms//os:linux",
    ],
    exec_properties = {
        # Provider-specific. Override in the consuming workspace if your
        # RBE service uses a different key or image reference scheme.
        "container-image": "docker://ghcr.io/YOUR_ORG/was110-rbe:latest",
    },
)
